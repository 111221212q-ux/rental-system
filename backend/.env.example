PORT=5000
# 本地路径。Sealos 使用 /data/rental.sqlite，并将持久卷挂到 /data。
SQLITE_PATH=./data/rental.sqlite
BACKUP_DIR=./data/backups
# 生成至少24字符的随机值。不要提交真实值。
JWT_SECRET=replace-with-a-long-random-secret
# 仅在空库首次启动时使用。留空则生成随机密码，写入数据目录 initial-admin.txt。
INITIAL_ADMIN_USERNAME=sa_882f4ca6
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=admin@rental.local
# 邮件任选 Resend 或 SMTP，真实配置仅放环境变量。
RESEND_API_KEY=
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Rental
EMAIL_FROM_EMAIL=
CONTACT_LOCATION=15-234
